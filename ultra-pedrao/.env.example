# ===== Ultra Pedrão — copie para .env e preencha. NUNCA comite o .env com segredos. =====

# MODO: shadow (padrão seguro, não envia) | pilot (só allowlist) | live (todos)
BOT_MODE=shadow
PILOT_ALLOWLIST=5521964450618          # números de teste (Bruno/Yan) separados por vírgula

# ----- FlowSeller API externa (tela API/Webhook) -----
FS_BASE=https://servapi.flowseller.com.br
FS_APIID_RESPOSTA=                       # UUID da config "resposta ia" (manter atendimento aberto)
FS_JWT_RESPOSTA=                         # token JWT dessa config
FS_APIID_TRANSFER=                       # UUID da config de transferência (opcional)
FS_JWT_TRANSFER=
FS_WEBHOOK_SECRET=                       # defina um segredo e configure no campo Webhook (validação)

# ----- IA / cérebro -----
LLM_PROVIDER=claude_cli                  # claude_cli (token 1 ano, grátis) | anthropic | gemini | fake
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=               # token de 1 ano (claude setup-token) se LLM_PROVIDER=claude_cli
LLM_TIMEOUT=40

# ----- transcrição de áudio -----
TRANSCRICAO_PROVIDER=gemini              # gemini (grátis, aceita áudio) | none
TRANSCRICAO_MAX_MB=16                    # áudios maiores são recusados (pede confirmação por escrito)

# ----- /planos (imagens servidas pela própria VPS) -----
PUBLIC_BASE_URL=                         # ex.: https://pedrao.seudominio.com.br (a VPS serve /planos/*)
# PLANOS_IMAGENS=                        # opcional: URLs explícitas separadas por vírgula (senão usa data/planos/)

# ----- comportamento -----
DEBOUNCE_SECONDS=6
SO_FORA_DO_HORARIO=true
TZ=America/Sao_Paulo
VIAB_LIMIAR_PREDIO=3

# ----- memória / retenção -----
SQLITE_PATH=/app/data/memoria.db
MEM_RETENCAO_DIAS=90

# ----- servidor / admin -----
PORT=8080
ADMIN_TOKEN=                             # defina um token forte p/ proteger /admin/*
