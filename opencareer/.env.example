# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Persistence (Postgres adapter — see docs/self-hosting.md)
# When unset, the API starts with the in-memory repository (development only).
DATABASE_URL=postgresql://opencareer:opencareer@localhost:5432/opencareer

# Public base URL used when emitting portable profile documents
PUBLIC_BASE_URL=http://localhost:3000
